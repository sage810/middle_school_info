    </div>

    <div class="content">

      <div class="intro">
        <div class="tag">WELCOME</div>
        <div class="body">
          우리 반 정보 수업 활동지를 모아둔 곳이에요.<br>
          아래 차시에서 오늘 수업을 눌러 시작해요.
        </div>
      </div>

      <!-- ============================================================
           차시 목록은 이 파일 하나만 고치면 됩니다.
           - 유닛(unit) 제목/색은 자유롭게 바꾸세요.
           - lesson.file 에는 실제로 만든 활동지 html 파일명을 적어요.
           - lesson.locked: true 로 두면 카드가 흐리게 표시되고 링크가 걸리지 않아요
             (아직 활동지를 안 만든 차시는 이렇게 자리만 잡아두면 됩니다).
           ============================================================ -->
      <div id="units"></div>

    </div>
  </div>
  <footer>MADE WITH ❤ FOR OUR CLASS</footer>
</div>

<script>
// 유닛(단원)과 차시 목록 — 여기만 고치면 홈페이지 전체가 업데이트됩니다.
const UNITS = [
  {
    title: "크리에이터 데뷔 프로젝트",
    badge: "UNIT_01",
    badgeColor: "#f9cade",
    lessons: [
      { num: "1차시", title: "디지털 데이터란?", desc: "활동지를 만들면 여기 설명을 채워요.", file: "lesson01.html" },
      { num: "2차시", title: "파일 확장자와 용량", desc: "", file: "lesson02.html", locked: true },
    ]
  },
  {
    title: "문제 정하기와 데이터 정리",
    badge: "UNIT_02",
    badgeColor: "#c4d8f7",
    lessons: [
      { num: "3차시", title: "풀 수 있는 문제 정하기", desc: "", file: "lesson03.html", locked: true },
    ]
  },
  {
    title: "데이터 분석 과정",
    badge: "UNIT_03",
    badgeColor: "#bfe9dd",
    lessons: [
      { num: "4차시", title: "스프레드시트 기초", desc: "", file: "lesson04.html", locked: true },
      { num: "5차시", title: "데이터 시각화", desc: "", file: "lesson05.html", locked: true },
    ]
  },
  {
    title: "데이터 과학과 진로",
    badge: "UNIT_04",
    badgeColor: "#fbe6a2",
    lessons: [
      { num: "6차시", title: "데이터로 하는 일들", desc: "", file: "lesson06.html", locked: true },
    ]
  },
];

const unitsEl = document.getElementById('units');
UNITS.forEach((unit, ui) => {
  const section = document.createElement('div');
  section.className = 'unit';

  const head = document.createElement('div');
  head.className = 'unit-head';
  head.innerHTML =
    '<h2>' + unit.title + '</h2>' +
    '<span class="badge" style="background:' + unit.badgeColor + '">' + unit.badge + '</span>';
  section.appendChild(head);

  const grid = document.createElement('div');
  grid.className = 'lesson-grid';

  unit.lessons.forEach((lesson) => {
    const isLocked = !!lesson.locked;
    const card = document.createElement(isLocked ? 'div' : 'a');
    if (!isLocked) card.href = lesson.file;
    card.className = 'lesson-card' + (isLocked ? ' locked' : '');
    card.innerHTML =
      '<div class="head" style="background:' + unit.badgeColor + '">' +
        '<span>' + lesson.num.toUpperCase() + '</span>' +
        '<span class="open">' + (isLocked ? '준비 중' : '▶ 열기') + '</span>' +
      '</div>' +
      '<div class="body">' +
        '<div class="num">' + lesson.num + '</div>' +
        '<div class="name">' + lesson.title + '</div>' +
        (lesson.desc ? '<div class="desc">' + lesson.desc + '</div>' : '') +
      '</div>';
    grid.appendChild(card);
  });

  section.appendChild(grid);
  unitsEl.appendChild(section);
});
</script>
</body>
</html>

